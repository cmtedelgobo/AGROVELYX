
{
  "name": "agrovelyx",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agrovelyx-prod",
      "database_id": "COLE_AQUI_O_DATABASE_ID"
    }
  ]
}
